{
  "version": 1,
  "appearance": {
    "theme": "dark",
    "accent": "#4f8cff",
    "layout": "auto",
    "button_size": 104,
    "columns_portrait": 3,
    "columns_landscape": 6,
    "show_labels": true
  },
  "pages": [
    {
      "id": "media",
      "name": "Multimedia",
      "icon": "music",
      "items": [
        { "kind": "widget", "id": "now-playing", "widget": "now_playing", "w": 3, "h": 2 },
        { "kind": "button", "id": "prev", "label": "Anterior", "icon": "skip-back",
          "action": { "type": "media", "command": "prev" } },
        { "kind": "button", "id": "play-pause", "label": "Play/Pausa", "icon": "play-pause", "color": "#1db954",
          "action": { "type": "media", "command": "play_pause" } },
        { "kind": "button", "id": "next", "label": "Siguiente", "icon": "skip-forward",
          "action": { "type": "media", "command": "next" } },
        { "kind": "widget", "id": "volume", "widget": "volume", "w": 3, "h": 1 },
        { "kind": "button", "id": "vol-down", "label": "Vol -", "icon": "volume-1",
          "action": { "type": "volume", "op": "step", "value": -5 } },
        { "kind": "button", "id": "mute", "label": "Silencio", "icon": "volume-x",
          "action": { "type": "volume", "op": "toggle_mute" } },
        { "kind": "button", "id": "vol-up", "label": "Vol +", "icon": "volume-2",
          "action": { "type": "volume", "op": "step", "value": 5 } },
        { "kind": "button", "id": "spotify", "label": "Spotify", "icon": "music", "color": "#1db954",
          "action": { "type": "url", "url": "spotify:" } }
      ]
    },
    {
      "id": "pc",
      "name": "PC",
      "icon": "monitor",
      "items": [
        { "kind": "widget", "id": "clock", "widget": "clock", "w": 3, "h": 1 },
        { "kind": "widget", "id": "stats", "widget": "stats", "w": 3, "h": 1 },
        { "kind": "button", "id": "explorer", "label": "Explorador", "icon": "folder", "color": "#e8a33d",
          "action": { "type": "launch", "path": "explorer.exe" } },
        { "kind": "button", "id": "taskmgr", "label": "Tareas", "icon": "activity",
          "action": { "type": "keys", "combo": "ctrl+shift+esc" } },
        { "kind": "button", "id": "desktop", "label": "Escritorio", "icon": "layout",
          "action": { "type": "keys", "combo": "win+d" } },
        { "kind": "button", "id": "screenshot", "label": "Recorte", "icon": "camera",
          "action": { "type": "keys", "combo": "win+shift+s" } },
        { "kind": "button", "id": "notepad-demo", "label": "Demo macro", "icon": "file-text", "color": "#9b59b6",
          "action": { "type": "macro", "steps": [
            { "type": "launch", "path": "notepad.exe" },
            { "type": "wait", "ms": 1500 },
            { "type": "keys", "text": "¡Hola desde PhoneDeck!" }
          ] } },
        { "kind": "button", "id": "github", "label": "GitHub", "icon": "globe",
          "action": { "type": "url", "url": "https://github.com" } },
        { "kind": "button", "id": "steam", "label": "Steam", "icon": "app",
          "action": { "type": "app", "app": "steam" } },
        { "kind": "button", "id": "epic-games", "label": "Epic Games", "icon": "app",
          "action": { "type": "app", "app": "epic" } },
        { "kind": "button", "id": "visual-studio", "label": "Visual Studio", "icon": "app",
          "action": { "type": "app", "app": "visualstudio" } },
        { "kind": "button", "id": "brave", "label": "Brave", "icon": "app",
          "action": { "type": "app", "app": "brave" } },
        { "kind": "button", "id": "lock", "label": "Bloquear", "icon": "lock", "color": "#c0392b",
          "action": { "type": "system", "command": "lock" } },
        { "kind": "button", "id": "monitor-off", "label": "Apagar pantalla", "icon": "monitor-off",
          "action": { "type": "system", "command": "monitor_off" } },
        { "kind": "button", "id": "sleep", "label": "Suspender", "icon": "moon", "confirm": true,
          "action": { "type": "system", "command": "sleep" } }
      ]
    },
    {
      "id": "mixer",
      "name": "Volume Mixer",
      "icon": "sliders",
      "items": [
        { "kind": "widget", "id": "mixer-master", "widget": "volume", "w": 6, "h": 1 },
        { "kind": "widget", "id": "mixer", "widget": "mixer", "w": 6, "h": 4 }
      ]
    },
    {
      "id": "pomodoro",
      "name": "Pomodoro",
      "icon": "timer",
      "items": [
        { "kind": "widget", "id": "pomodoro", "widget": "pomodoro", "w": 6, "h": 4 }
      ]
    },
    {
      "id": "obs",
      "name": "OBS",
      "icon": "video",
      "items": [
        { "kind": "widget", "id": "obs", "widget": "obs", "w": 6, "h": 4 }
      ]
    },
    {
      "id": "spotify",
      "name": "Spotify",
      "icon": "spotify",
      "items": [
        { "kind": "widget", "id": "spotify", "widget": "spotify", "w": 6, "h": 4 }
      ]
    }
  ]
}
