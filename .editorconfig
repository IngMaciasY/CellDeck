root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json,yml,yaml,toml}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf
# PowerShell 5.1 lee los .ps1 sin BOM como ANSI y rompe las tildes
charset = utf-8-bom
